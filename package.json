{
  "name": "pi-launcher",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Manage OMP accounts and open one Pi Desktop window per account",
  "author": "Pat Fox",
  "license": "MIT",
  "homepage": "https://github.com/PatFox/pi-launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/PatFox/pi-launcher.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src scripts",
    "test": "node scripts/run-tests.mjs",
    "package": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "clsx": "^2.1.1",
    "electron": "^43.7.7",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.23.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "dev.pi.launcher",
    "productName": "Pi Launcher",
    "copyright": "Copyright 2026 Pat Fox. Licensed under the MIT License.",
    "files": [
      "out/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "Pi-Launcher-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pi Launcher",
      "artifactName": "Pi-Launcher-${version}-${os}-${arch}-setup.${ext}"
    }
  }
}
